PORT=4000

# Customer context service. It is not public, so run the panel on the EC2 box
# (http://127.0.0.1:3000) or somewhere that can reach it.
CONTEXT_SERVICE_URL=http://127.0.0.1:3000
CONTEXT_SERVICE_API_KEY=
# ^ Same key as the bot's CONTEXT_SERVICE_API_KEY. Needed to save panel replies to the chat history.

# Stores the panel can switch between; the first is shown by default.
STORE_IDS=little-bansi

# Dummy login, until there is a real user table.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Signs the login cookie. Set a long random string in production.
SESSION_SECRET=change-me

# production = read conversations from MongoDB; mock = built-in dummy data.
NODE_ENV=production

# The customer context service's database (see docs/CONVERSATION_TABLES.md).
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.wsqndf2.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=customer_context

# Replies sent from the panel go out from the bot's WhatsApp number.
# Use the same values as wa-faq-cloud's .env.
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# Broadcast templates are read from this account. WhatsApp Manager ->
# Account tools / API Setup shows it as "WhatsApp Business Account ID".
WHATSAPP_BUSINESS_ACCOUNT_ID=

# The bot's base URL (wa-faq-cloud). After a panel reply, the panel calls
# BOT_URL/api/takeover so the bot stays quiet for that customer for 5 minutes.
BOT_URL=
